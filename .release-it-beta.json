{
  "$schema": "node_modules/release-it/schema/release-it.json",
  "git": false,
  "github": {
    "release": false,
    "preRelease": false
  },
  "npm": {
    "publish": true,
    "tag": "next"
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "header": "# Changelog"
    }
  }
}
